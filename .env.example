# ============================================================
# Project Noor — Environment Variables (copy to .env)
# ============================================================
# Copy this file to ".env" and fill in your values.
# On Render, set the same variables under Environment.
#
# ┌─────────────────────────────────────────────────────────────┐
# │  FREE LLM — কীভাবে Groq key নেবেন (৩০ সেকেন্ড)              │
# │                                                             │
# │  1. https://console.groq.com/keys এ যান                     │
# │  2. ফ্রি account বানাও (Google/Login — কোনো কার্ড লাগে না)    │
# │  3. "Create API Key" → কপি করো                               │
# │  4. নিচে LLM_API_KEY= এর পাশে বসাও                           │
# │                                                             │
# │  ফ্রি tier: দিনে 14,000+ requests — MVP-এর জন্য অনেক বেশি।   │
# │  OpenAI-র চেয়ে 10x দ্রুত, বাংলা+English দুটোতেই ভালো।       │
# └─────────────────────────────────────────────────────────────┘
# ============================================================

# --- LLM provider ---
# "groq" (FREE, recommended) | "openai" | "together" | "openrouter"
LLM_PROVIDER=groq

# --- LLM API key (the only thing you MUST set) ---
# Groq থেকে নেওয়া ফ্রি key এখানে বসাও:
LLM_API_KEY=

# (ঐচ্ছিক) মডেল / base_url override — না দিলে provider অনুযায়ী ডিফল্ট চলবে।
# Groq default: openai/gpt-oss-120b  (বর্তমান ফ্রি-টিয়ার মডেল)
# ⚠️ আগের "llama-3.3-70b-versatile" ২০২৬-০৮-১৬ তে বন্ধ — সেটা দিলে 404 আসবে।
# অন্য ফ্রি alt: qwen/qwen3-32b (তেজি, ভালো Bangla)
# LLM_MODEL=
# LLM_BASE_URL=

# Set to "1" to print extra safety + LLM logs to the console for debugging.
DEBUG_SAFETY=0

# --- Flask ---
# Use a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# AUTO means: Render uses production settings, local uses debug.
FLASK_ENV=development
